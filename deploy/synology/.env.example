# =============================================================================
# Yasun Studio — production environment for the Synology NAS
# Copy to /volume1/docker/yasun-studio/.env and fill every <...> value.
# Generate secrets with:  openssl rand -hex 32
# =============================================================================

# ---- Images (built & pushed by GitHub Actions) --------------------------------
REGISTRY=ghcr.io/yasunstudio
# "latest" follows main; pin a commit tag (sha-xxxxxxx) for reproducible rollbacks.
IMAGE_TAG=latest

# ---- Public URL (must match the Cloudflare public hostname) ---------------------
SITE_URL=https://<DOMAIN>
FRONTEND_URL=https://<DOMAIN>
CORS_ORIGINS=https://<DOMAIN>
# Port for LAN-only troubleshooting access: http://<NAS-IP>:8088
LAN_PORT=8088

# ---- Backend -------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=<openssl rand -hex 32>
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# 2 workers suit a 2–4 GB NAS; raise on bigger models.
WEB_CONCURRENCY=2

FIRST_SUPERUSER_EMAIL=<admin@DOMAIN>
FIRST_SUPERUSER_PASSWORD=<strong password — change it after first login>
SEED_SAMPLE_DATA=false

# ---- PostgreSQL ----------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=yasun
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=yasun_studio

# ---- Redis ---------------------------------------------------------------------
REDIS_PASSWORD=<openssl rand -hex 24>
# Must repeat REDIS_PASSWORD:
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
CACHE_TTL_SECONDS=300

# ---- Cloudflare Tunnel ---------------------------------------------------------
# Zero Trust → Networks → Tunnels → your tunnel → "Install connector" → copy the token.
CLOUDFLARE_TUNNEL_TOKEN=<eyJ...>
