# =============================================================================
# Yasun Studio — environment configuration
# Copy to .env and adjust:  cp .env.example .env
# =============================================================================

# ---- General -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=yasun-studio
ENVIRONMENT=local
LOG_LEVEL=INFO
# Public port of the nginx gateway
HTTP_PORT=80

# Dev-only host ports (docker-compose.override.yml) — change if already in use
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# ---- Backend (FastAPI) -------------------------------------------------------
# Generate with:  openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost:3000,http://localhost
WEB_CONCURRENCY=4

FIRST_SUPERUSER_EMAIL=admin@yasunstudio.com
FIRST_SUPERUSER_PASSWORD=ChangeMe123!
SEED_SAMPLE_DATA=true

# ---- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=yasun
POSTGRES_PASSWORD=yasun-secret
POSTGRES_DB=yasun_studio

# ---- Redis -------------------------------------------------------------------
REDIS_PASSWORD=redis-secret
REDIS_URL=redis://:redis-secret@redis:6379/0
CACHE_TTL_SECONDS=300

# ---- Frontend (Next.js) ------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost
API_INTERNAL_URL=http://backend:8000/api/v1
# Set true ONLY to test the production build over plain HTTP (cookies are Secure otherwise)
COOKIE_INSECURE=false
